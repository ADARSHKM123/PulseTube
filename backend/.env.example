# ── Required ────────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → API key
# (YouTube Data API v3 must be enabled on the project)
YOUTUBE_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Default (unset) = local SQLite file, zero setup. For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+asyncpg://pulsetube:pulsetube@localhost:5432/pulsetube
DATABASE_URL=

# ── Pipeline schedule ───────────────────────────────────────────────────────
# 120 min = 12 runs/day. Spec range is 8–12 daily runs (120–180 min).
PIPELINE_INTERVAL_MINUTES=120
# Fire one ingestion run as soon as the server boots (burns quota — off by default)
RUN_PIPELINE_ON_STARTUP=false

# ── Search strategy / quota budget ──────────────────────────────────────────
# search.list costs 100 units/call; keywords are searched round-robin,
# this many per run. 3 keywords × 12 runs = 3,600 units/day on search.
SEARCH_KEYWORDS_PER_RUN=3
SEARCH_MAX_RESULTS=25
# Only surface videos published within this window (viral = recent)
SEARCH_PUBLISHED_WITHIN_DAYS=7
# viewCount | relevance | date | rating
SEARCH_ORDER=viewCount
REGION_CODE=US
RELEVANCE_LANGUAGE=en

# Hard stop for the day once (limit - buffer) units are spent.
DAILY_QUOTA_LIMIT=10000
QUOTA_SAFETY_BUFFER=500

# Keep refreshing metrics for videos first seen within this many days
METRICS_REFRESH_WINDOW_DAYS=14
# Top comment threads pulled per video for sentiment
COMMENTS_MAX_PER_VIDEO=100

# ── Transcripts ─────────────────────────────────────────────────────────────
# youtube-transcript-api (free library) | supadata (paid HTTP API)
TRANSCRIPT_PROVIDER=youtube-transcript-api
SUPADATA_API_KEY=
SUPADATA_API_URL=https://api.supadata.ai/v1/youtube/transcript
# Max concurrent transcript fetches per run
TRANSCRIPT_CONCURRENCY=3

# ── Server ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
